<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/UnityThemes/MainMenuStyle.uss?fileID=7433441132597879392&amp;guid=250ed4051e5ffa14bb8745c6d7f75474&amp;type=3#MainMenuStyle" />
    <ui:VisualElement name="GameBG" style="flex-grow: 1; background-image: url(&apos;project://database/Assets/Textures/starry%20bg%202.png?fileID=2800000&amp;guid=9b77b062edd5845488c54dd374367df9&amp;type=3#starry bg 2&apos;); justify-content: center; align-items: flex-start;">
        <ui:VisualElement name="MainMenuContainer" style="flex-grow: 0; width: 800px; height: 1300px; background-color: rgba(0, 0, 0, 0.57); border-top-width: 5px; border-right-width: 5px; border-bottom-width: 5px; border-left-width: 5px; border-top-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 190, 71); border-left-color: rgb(255, 190, 71); border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px; justify-content: flex-start; align-items: flex-start; align-self: flex-start;">
            <ui:GroupBox style="justify-content: space-around; align-self: center; align-items: flex-end;">
                <ui:Button text="Play" name="play" class="main-menu-style play-button" />
                <ui:Button text="Options" name="settings" class="main-menu-style options-button" />
                <ui:Button text="Delete" name="delete" class="main-menu-style delete-button" />
            </ui:GroupBox>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
