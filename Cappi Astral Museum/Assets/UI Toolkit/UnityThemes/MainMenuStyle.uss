.main-menu-style {
    width: 450px;
    height: 120px;
    margin-top: 100px;
    margin-right: 100px;
    margin-bottom: 100px;
    margin-left: 100px;
    -unity-font-style: bold;
    font-size: 40px;
    text-shadow: 2px 2px 0 rgba(0, 0, 0, 0.87);
    color: rgb(255, 255, 255);
    border-top-width: 5px;
    border-right-width: 5px;
    border-bottom-width: 5px;
    border-left-width: 5px;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
    border-bottom-left-radius: 20px;
}

.options-button {
    -unity-background-image-tint-color: rgb(245, 68, 68);
    background-color: rgba(171, 171, 171, 0.8);
}

.options-button:hover {
    -unity-background-image-tint-color: rgb(245, 68, 68);
    background-color: rgba(103, 103, 103, 0.8);
}

.delete-button:hover {
    background-color: rgba(94, 19, 19, 0.93);
}

.delete-button {
    background-color: rgba(185, 34, 34, 0.93);
}

.play-button:hover {
    background-color: rgba(255, 200, 100, 0.84);
}

.play-button {
    background-color: rgba(253, 174, 30, 0.84);
}
